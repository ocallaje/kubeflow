



trace {
  enabled = true
  file = '/work/launch/trace.txt'
  overwrite = true
}

cleanup = true



profiles {
    standard {
        process.executor = 'local'
    }

    k8s {
        process {
          executor = 'k8s'
          errorStrategy = 'retry'
          maxRetries = 3
          pod {
            nodeSelector: ['workload=compute']
            automountServiceAccountToken = true
            ttlSecondsAfterFinished = 60
          }

          // Process Images
          withName: sayHello {
            container = '134.226.153.55:30002/nextflow/nf-task:0.1'
          }

        }

        k8s {
          namespace = 'nextflow'
          computeResourceType = 'Job'
          fetchNodeName = true
          serviceAccount = 'nextflow-submitter'
          storageClaimName = 'nextflow-workdir'
          storageMountPath = '/work'
          launchDir = '/work/launch'
          workDir = '/work/work'
        }



    }
}